# Copy to .env and fill in. Never commit .env.
ENV=dev

# Supabase -> Project Settings -> Database -> Connection string (Session pooler, region ap-south-1).
# Format: postgresql+psycopg://postgres.<project-ref>:<db-password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
DATABASE_URL=sqlite:///./dev.db

# Any long random string; used to sign JWTs from Stage 2 onward.
SECRET_KEY=change-me-to-a-long-random-string

# Auth (Stage 2). Access token lifetime in minutes, refresh token lifetime in days.
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
# Send auth cookies only over HTTPS. Always on when ENV=prod, regardless of this value.
COOKIE_SECURE=false
# Make successfully completed reports available without manual admin review.
AUTO_APPROVE_ANALYSES=true
# Billing is in USD: one flat $65/month (Rs. 15,000 + 20% = Rs. 18,000, at ~276 PKR/USD).
# No performance fee by default. An admin can still set one per client; recovered waste
# is in rupees and is then converted at PKR_PER_USD, frozen onto each invoice when drafted.
NEW_CLIENT_BASE_FEE=65
NEW_CLIENT_PERFORMANCE_FEE_PCT=0
PKR_PER_USD=276

# Card payments in USD through Lemon Squeezy (README "Deploy" step 5). Leave blank to offer
# bank transfer only; card payments switch on when all four LEMONSQUEEZY_* values are set.
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_VARIANT_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
# The frontend's public origin; the checkout sends clients back to its billing page.
PUBLIC_APP_URL=http://localhost:3000

# File storage (Stage 3). "local" writes to STORAGE_ROOT on disk; "supabase" arrives in Stage 8.
STORAGE_BACKEND=local
STORAGE_ROOT=./storage
# Reject uploads larger than this many megabytes.
MAX_UPLOAD_MB=20

# --- Stage 8 ---------------------------------------------------------------
# Comma-separated list of browser origins allowed to call this API.
CORS_ORIGINS=http://localhost:3000

# Largest request body the API accepts, in MB. Uploads have their own MAX_UPLOAD_MB cap.
MAX_REQUEST_MB=25

# Leave empty in dev: Sentry stays off when there is no DSN.
SENTRY_DSN=

# File storage. "local" writes under STORAGE_ROOT; "supabase" uses the private bucket below.
STORAGE_BACKEND=local
STORAGE_BUCKET=ad-optimizer
# Supabase -> Project Settings -> API. The service_role key is BACKEND ONLY.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
