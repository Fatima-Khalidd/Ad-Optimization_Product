# Copy to `.env` in this directory before `docker compose up`. This file configures the
# container stack only; the bare-metal dev workflow still uses backend/.env and
# frontend/.env.local (see README.md "Run locally").
#
# `backend/.env` is read by pydantic-settings, but real environment variables win, so the
# values below are what the containers actually use.
#
#   cp .env.example .env
#
# Keep passwords alphanumeric: they are interpolated into DATABASE_URL, and characters
# like @, / or % would have to be percent-encoded.

# --- Postgres (service `db`, data on the adopt-pgdata named volume) ----------
POSTGRES_USER=adoptimizer
POSTGRES_DB=adoptimizer
POSTGRES_PASSWORD=change-me-9f3a1c

# --- Backend ------------------------------------------------------------------
# Signed JWTs live in this; ENV=dev tolerates a short value, but use >=32 chars anyway.
SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
# Where the login rate limiter keeps counters. `redis://redis:6379/0` is this stack's
# Redis. Per-instance state is fine for a single machine; an Auto Scaling Group needs one
# shared endpoint for all nodes, or memory:// if you accept a per-instance login limit.
RATE_LIMIT_STORAGE_URI=redis://redis:6379/0
# Uploaded CSVs and PDFs are written under STORAGE_ROOT inside the container.
MAX_UPLOAD_MB=20
# Shown by GET /api/health so you can tell which node served a request. Left empty, the
# backend reports its container hostname; the EC2 launch template fills in the instance id.
INSTANCE_LABEL=

# --- Frontend -----------------------------------------------------------------
FRONTEND_PORT=3000
# 127.0.0.1 keeps the API off the LAN. The EC2 launch template sets 0.0.0.0 so the load
# balancer can reach it, and the instance security group restricts 8000 to the ALB.
BACKEND_BIND=127.0.0.1
BACKEND_PORT=8000
# Only used if the browser talks to the API directly; the Next.js server-side proxy makes
# the usual path same-origin, so the defaults are enough.
CORS_ORIGINS=http://localhost:3000
PUBLIC_APP_URL=http://localhost:3000

# --- scripts.seed_demo (docker compose --profile seed run seed) ---------------
# Required to seed, and used again by the Selenium run to sign in.
DEMO_EMAIL=demo@example.com
DEMO_PASSWORD=change-me-demo-password
